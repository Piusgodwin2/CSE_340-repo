<%- include('partials/header') %>
    <main>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
             <li>
                <strong><%= new Date(project.project_date).toLocaleDateString() %>: </strong>
                <%= project.title %>  (<strong><%= project.organization_name %></strong>)
            </li>            
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>