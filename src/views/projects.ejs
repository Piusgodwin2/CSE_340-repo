<%- include('partials/header') %>
    <main>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
             <li>
                <strong><%= new Date(project.date).toLocaleDateString() %>: </strong>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<strong><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></strong>)
            </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>